# This POC has no backend and no secrets — nothing here is sensitive.
# Copy this file to .env (gitignored) before `docker compose up`.
# Kept as its own file so the compose file never needs editing for a
# config change, and so this stays the one place a real credential
# would go if the app ever grows a backend.

NODE_ENV=production

# Live finance mode (ADR 0015) — talks to homelab-hub/services/conduit's
# finance module instead of the bundled fixtures. These are NEXT_PUBLIC_*
# vars: Next.js inlines them into the client bundle at BUILD time, so
# changing them requires `docker compose build` (not just `up -d`/restart).
# Leave NEXT_PUBLIC_FINANCE_LIVE unset or "0" to keep the fixture demo.
NEXT_PUBLIC_FINANCE_LIVE=1
# Point at wherever homelab-hub's conduit is reachable from THIS
# container. homelab-hub's docker-compose.yml publishes conduit on host
# port 8088 (container 8080) — e.g. http://ezio:8088/api/v1/finance or
# the host's Tailscale/LAN address. "localhost" only works if this
# container and conduit share a Docker network or the host network.
NEXT_PUBLIC_FINANCE_API_BASE=http://ezio:8088/api/v1/finance
